    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
